<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cho phep HTTP cleartext chi den may chay backend o moi truong dev.
        Production phai dung HTTPS va xoa cac domain-config o day.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- IP LAN may dev - doi bang IP may cua ban khi chay that -->
        <domain includeSubdomains="true">192.168.1.5</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
