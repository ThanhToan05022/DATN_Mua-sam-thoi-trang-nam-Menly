# ==========================================
# MenShop Backend - Bien moi truong
# Sao chep file nay thanh .env roi dien gia tri
#   cp .env.example .env
# ==========================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Supabase (PostgreSQL + Auth + Storage) ---
# Lay cac gia tri tai Project Settings > API trong Supabase Dashboard
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Bat buoc khi can quyen quan tri (doc Service Role key trong Supabase Dashboard)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- VNPay Sandbox ---
# Thay bang thong tin tai khoan sandbox cua ban
# Docs: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=DEMOMENSHOP
VNPAY_HASH_SECRET=SECRETKEYFORSANDBOXTESTING1234567890
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Dia chi backend cua ban, VNPay se redirect ve day sau khi thanh toan
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return

# --- Database ---
# true  = dung du lieu gia lap trong bo nho (khong can Supabase, de chay demo nhanh)
# false = dung Supabase that
USE_MOCK_DB=true
