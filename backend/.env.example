# Sao chép file này thành .env rồi điền cấu hình riêng trên máy.
# Không đẩy file .env thật hoặc khóa dịch vụ lên Git.

PORT=5000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Đặt true để chạy dữ liệu mẫu cục bộ; false để kết nối Supabase.
USE_MOCK_DB=false

VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return
